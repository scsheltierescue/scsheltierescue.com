---
import 'src/styles/global.css';

import Layout from '@layouts/Layout.astro';
---

<Layout
  title="Events"
  description="Information about SC Sheltie Rescue events."
>
  <div class="row">
    <div class="large-12 medium-12 small-12 columns">
      <main id="main-content" class="events main-content">
        <h1 class="headline first">Events</h1>
        <div class="border border-solid block font-normal my-5 p-3 relative bg-primary-c border-primary-c-darker text-zinc-100">
          <p class="mb-0"><strong>Check back here for scheduled events.</strong></p>
        </div>
      </main>
    </div>
  </div>
</Layout>
