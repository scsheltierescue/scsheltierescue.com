---
import 'src/styles/global.css';

import Layout from '@layouts/Layout.astro';
import Slider from '@components/Slider.astro';

import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import scsrLogoImg from '@images/SCSR-Logo-New_500x606.jpg';
import kronosImg from '@images/kronos_667x500.jpg';
import nashImg from '@images/nash_667x500.jpg';
import shadowImg from '@images/shadow_667x500.jpg';
import savvyImg from '@images/savvy_667x500.jpg';
import nash2Img from '@images/nash2_667x500.jpg';
import brittImg from '@images/britt_667x500.jpg';
import litaImg from '@images/lita_667x500.jpg';

import type { Item } from '@components/Slider.astro';

const sliderItems: Item[] = [
  { src: kronosImg, alt: 'Kronos, a rescued Sheltie' },
  { src: nashImg, alt: 'Nash, a rescued Sheltie' },
  { src: shadowImg, alt: 'Shadow, a rescued Sheltie' },
  { src: savvyImg, alt: 'Savvy, a rescued Sheltie' },
  { src: nash2Img, alt: 'Nash, a rescued Sheltie' },
  { src: brittImg, alt: 'Britt, a rescued Sheltie' },
  { src: litaImg, alt: 'Lita, a rescued Sheltie' },
];

const actionBaseClasses = 'inline-flex min-h-11 w-full items-center justify-center px-5 py-3 text-center font-semibold md:w-auto';
const primaryActionClasses = `${actionBaseClasses} bg-primary-c text-white hover:bg-primary-c-darker hover:text-white focus:text-white`;
const secondaryActionClasses = `${actionBaseClasses} bg-neutral-200 text-zinc-800 hover:bg-neutral-300 hover:text-zinc-900 focus:bg-neutral-300 focus:text-zinc-900`;
const actionCardClasses = 'flex flex-col px-5 py-3 md:p-5';
const cardActionClasses = 'mt-auto inline-flex min-h-11 items-center self-start py-2 font-semibold';
---

<Layout
  title="South Carolina Sheltie Rescue"
  description="South Carolina Sheltie Rescue is a non-profit volunteer group dedicated to helping Shetland Sheepdogs in South Carolina and the surrounding areas."
>
  <div id="main-content" class="row">
    <div class="large-12 medium-12 small-12 columns">
      <div class="clearfix mt-4 border border-solid border-stone-300 bg-neutral-200 p-5 mb-5 text-zinc-800">
        <div class="large-4 columns">
          <a href="/">
            <Image
              src={scsrLogoImg}
              loading="eager"
              alt="SCSR logo"
              class="block mx-auto mb-5"
            />
          </a>
          <h1 class="text-2xl font-semibold">South Carolina Sheltie Rescue</h1>
          <p class="mb-0">We are a volunteer-run, foster-based rescue helping displaced, abandoned, and abused Shelties find lasting homes.</p>
        </div>
        <div class="large-8 columns mt-0 max-md:mt-5 max-md:px-0! md:pr-0!">
          <div class="main-header-picture-slider mx-auto max-w-[41.6875rem]">
            <Slider items={sliderItems} />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="large-12 medium-12 small-12 columns">
      <main class="main-content">
        <section class="mb-5 border border-stone-300 bg-stone-100 p-5" aria-labelledby="home-actions-heading">
          <div class="mb-5">
            <h2 id="home-actions-heading" class="headline first">How You Can Help</h2>
            <p class="mb-0">Whether you’re ready to adopt, interested in fostering, need help surrendering a Sheltie, or want to support dogs in our care, choose an option below to get started.</p>
          </div>

          <article class="adoption-action border border-primary-c bg-cyan-50 p-5 mb-4">
            <h3 class="text-2xl font-semibold">Adopt a Sheltie</h3>
            <p>Meet the Shelties looking for homes, review our adoption requirements, and submit an application when you are ready.</p>
            <div class="grid gap-3 md:flex md:flex-wrap">
              <a class={primaryActionClasses} href="/adoptable-dogs/">View Adoptable Dogs</a>
              <a class={secondaryActionClasses} href="/adoption-requirements/">Review Adoption Requirements</a>
              <a class={secondaryActionClasses} href="https://docs.google.com/forms/d/e/1FAIpQLSeWT2ExXhpCpz-K5fELnkeUzhv5jFynlBzkv3eXl7bRnoFjVw/viewform" target="_blank" rel="noopener noreferrer">Apply to Adopt <Icon name="external-link" title="external link" size=10 class="ml-1 inline align-text-top" /></a>
            </div>
          </article>

          <div class="secondary-actions grid gap-2 md:grid-cols-3 md:gap-4">
            <article class={actionCardClasses}>
              <h3 class="text-xl font-semibold">Foster a Sheltie</h3>
              <p class="grow">Open your home temporarily and give a rescued Sheltie the care and stability they need.</p>
              <a class={cardActionClasses} href="/help/articles/fostering/">Learn About Fostering</a>
            </article>

            <article class={actionCardClasses}>
              <h3 class="text-xl font-semibold">Surrender a Sheltie</h3>
              <p class="grow">Contact us for help if a Sheltie in your care needs a safe path into rescue.</p>
              <a class={cardActionClasses} href="/surrender/">Get Surrender Information</a>
            </article>

            <article class={actionCardClasses}>
              <h3 class="text-xl font-semibold">Support the Rescue</h3>
              <p class="grow">Help cover veterinary care, medicine, food, and other needs for Shelties in foster homes.</p>
              <a class={cardActionClasses} href="#donate">View Donation Options</a>
            </article>
          </div>
        </section>

        <section class="recent-donations mb-5 bg-primary-c p-7 text-white" aria-labelledby="recent-donations-heading">
          <h2 id="recent-donations-heading" class="text-white">Recent Donations - Thank You!</h2>
          <ul class="mb-0 columns-1 gap-8 sm:columns-2 lg:columns-3">
            <li class="mb-1 break-inside-avoid"><em>Mike F.</em></li>
            <li class="mb-1 break-inside-avoid"><em>The Bryan Family</em></li>
            <li class="mb-1 break-inside-avoid"><em>The Cobb Family</em></li>
            <li class="mb-1 break-inside-avoid"><em>Jim F. (in memory of Marsha Ferris)</em></li>
            <li class="mb-1 break-inside-avoid"><em>Francisco F. (in memory of Marsha Ferris)</em></li>
            <li class="mb-1 break-inside-avoid"><em>The Normand Family</em></li>
            <li class="mb-1 break-inside-avoid"><em>Betty J.</em></li>
            <li class="mb-1 break-inside-avoid"><em>The Lucas Family</em></li>
            <li class="mb-1 break-inside-avoid"><em>The Bowen Family</em></li>
            <li class="mb-1 break-inside-avoid"><em>The Fejes Family</em></li>
            <li class="mb-1 break-inside-avoid"><em>Judy J.</em></li>
            <li class="mb-1 break-inside-avoid"><em>The Pedigree Foundation</em></li>
            <li class="mb-1 break-inside-avoid"><em>The Miller Family</em></li>
            <li class="mb-1 break-inside-avoid"><em>Jackie A. (in memory of Betty Thompson)</em></li>
            <li class="mb-1 break-inside-avoid"><em>The Shuman Family</em></li>
            <li class="mb-1 break-inside-avoid"><em>Jane F.</em></li>
            <li class="mb-1 break-inside-avoid"><em>David & Mandy S. (in memory of Betty Thompson)</em></li>
            <li class="mb-1 break-inside-avoid"><em>The Mullane Family</em></li>
            <li class="mb-1 break-inside-avoid"><em>Ross M. (in memory of Ken Cannon)</em></li>
            <li class="mb-1 break-inside-avoid"><em>Janet W. & Lisa T. (in memory of Harvey Townsend)</em></li>
            <li class="mb-1 break-inside-avoid"><em>Mickey T. (in memory of M.B. Jenkins)</em></li>
          </ul>
        </section>
        <div class="large-6 columns">
          <h2 class="headline first">About Us</h2>
          <p>SC Sheltie Rescue is a volunteer-run, foster-based 501(c)(3) public charity. Our volunteers donate their time, abilities, and homes to help displaced, abandoned, and abused Shelties find a forever home. Our main goals are the protection and care of the Shelties already here, the prevention of over-breeding and poor breeding practices, and the education of any Sheltie owner who requests it.</p>
          <p>Our volunteer foster homes work with our SCSR foster Shelties by caring for them, evaluating their temperaments, housetraining them if necessary, and getting them to and from the vet for any necessary medical care.</p>
          <p><a href="https://app.candid.org/profile/9406292/sc-sheltie-rescue-or-south-carolina-sheltie-rescue-46-2874220" target="_blank" rel="noopener noreferrer">View our nonprofit profile on Candid <Icon name="external-link" title="external link" size=10 class="ml-1 inline align-text-top" /></a></p>
        </div>
        <div class="large-6 columns">
          <h2 class="headline">Adopting a Rescue Sheltie</h2>
          <p>The first step to adopting from SC Sheltie Rescue is to fill out the <a href="https://docs.google.com/forms/d/e/1FAIpQLSeWT2ExXhpCpz-K5fELnkeUzhv5jFynlBzkv3eXl7bRnoFjVw/viewform" target="_blank" rel="noopener noreferrer">Adoption Application <Icon name="external-link" title="external link" size=10 class="inline align-text-top" /></a> in full. Leaving answers blank may result in a delay in processing your application. We do not operate on a first-come, first-served basis. Instead, we aim to place our rescues in the best homes for them based on personality and any behavioral or medical issues that need to be considered. We reserve the right to refuse any applicant.</p>
          <p>Breed rescues exist because the people involved know the breed best --&nbsp;they often consist of past and current breeders, owners of the breed, and trainers. Shelties, like other purebreds, have certain behavioral and genetic traits that can present challenges to those unfamiliar with the breed. That&#39;s why we&#39;re here and why we feel we&#39;re qualified to match our rescued Shelties with the best homes <strong>FOR THEM</strong>.</p>
        </div>
        <section id="donate" class="large-12 columns scroll-mt-16 mb-5" aria-labelledby="donate-heading">
          <div class="border border-solid border-stone-300 bg-cyan-50 p-5 text-zinc-800">
            <h2 id="donate-heading" class="headline first">Support Shelties in Foster Care</h2>
            <p>SC Sheltie Rescue does not operate a physical shelter. Rescued Shelties live in foster homes while they receive the care and preparation they need for adoption.</p>
            <p>Donations help support veterinary evaluations, vaccinations, heartworm treatment and prevention, flea and tick prevention, spay/neuter surgery, medicine, and other rescue needs.</p>

            <div class="grid gap-6 pt-2 sm:grid-cols-2 md:grid-cols-3">
              <div>
                <h3 class="text-xl font-semibold">Donate with PayPal</h3>
                <p>Make a secure online donation through PayPal.</p>
                <!-- Paypal Donate Link -->
                <form class="m-0" action="https://www.paypal.com/cgi-bin/webscr" method="post" target="_top">
                  <input type="hidden" name="cmd" value="_s-xclick">
                  <input type="hidden" name="encrypted" value="-----BEGIN PKCS7----------END PKCS7-----
                ">
                  <input class="cursor-pointer" type="image" src="https://www.paypalobjects.com/en_US/i/btn/btn_donateCC_LG.gif" name="submit" alt="PayPal - The safer, easier way to pay online!">
                  <img alt="" src="https://www.paypalobjects.com/en_US/i/scr/pixel.gif" width="1" height="1">
                </form>
              </div>

              <div>
                <h3 class="text-xl font-semibold">Donate by Mail</h3>
                <p>Checks can be mailed to:</p>
                <address class="not-italic">
                  SC Sheltie Rescue<br>
                  P.O. Box 11224<br>
                  Rock Hill, SC 29731
                </address>
              </div>

              <div class="sm:col-span-2 md:col-span-1">
                <h3 class="text-xl font-semibold">Send Needed Supplies</h3>
                <p>Purchase useful items for rescued Shelties from our Amazon wishlist.</p>
                <a class="inline-flex min-h-11 items-center py-2 font-semibold" href="https://www.amazon.com/hz/wishlist/ls/1HXQOHF67S4CQ" target="_blank" rel="noopener noreferrer">Shop the Amazon Wishlist <Icon name="external-link" title="external link" size=10 class="ml-1 inline align-text-top" /></a>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>
</Layout>
