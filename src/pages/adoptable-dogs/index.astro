---
import 'src/styles/global.css';

import Layout from '@layouts/Layout.astro';

import { Icon } from 'astro-icon/components';

const petfinderURL = 'https://www.petfinder.com/search/pets-for-adoption/?shelterRescue=d6f7beda-4e29-45df-b0da-93522ec89617';
---

<Layout
  title="Adoptable Shelties"
  description="Browse Shelties available for adoption from SC Sheltie Rescue and learn how to submit an adoption application."
>
  <div class="row">
    <div class="large-12 medium-12 small-12 columns">
      <main id="main-content" class="main-content">
        <h1 class="headline first">Available for Adoption</h1>
        <p>You can view our available dogs below. If you are interested in adopting one of our rescue dogs, please complete and submit our <a href="https://docs.google.com/forms/d/e/1FAIpQLSeWT2ExXhpCpz-K5fELnkeUzhv5jFynlBzkv3eXl7bRnoFjVw/viewform" target="_blank" rel="noopener noreferrer">Adoption Application <Icon name="external-link" title="external link" size=10 class="inline align-text-top" /></a> form. If you have any questions, feel free to <!--email_off--><a href="mailto:adopt@scsheltierescue.com">email</a><!--/email_off--> us.</p>

        <aside class="mb-5 border border-stone-300 bg-stone-100 p-4" aria-label="Petfinder listing information">
          <p class="mb-3">Our listings are provided by Petfinder and may take a moment to appear. If they do not load, you can view every available dog directly on Petfinder.</p>
          <a class="inline-flex min-h-11 items-center font-semibold" href={petfinderURL} target="_blank" rel="noopener noreferrer">
            View Available Dogs on Petfinder
            <Icon name="external-link" title="external link" size=10 class="ml-1 inline align-text-top" />
          </a>
        </aside>

        <div id="pets" class="clearfix">
          <!-- Petfinder public API was retired. This page now uses Petfinder's official widget. -->
          <!-- Pet List Widget - Start -->
          <script src="https://www.petfinder.com/pet-scroller.bundle.js" defer></script>
          <pet-scroller
            s3Url="https://dbw3zep4prcju.cloudfront.net/"
            apiBase="https://psl.petfinder.com/graphql"
            organization='["SC92"]'
            status="adoptable"
            petfinderUrl="https://www.petfinder.com/"
            hideBreed="false"
            limit="48"
            petListTitle="">
          </pet-scroller>
          <!-- Pet List Widget - End -->

          <div class="mb-5"></div>
        </div>
      </main>
    </div>
  </div>
</Layout>
