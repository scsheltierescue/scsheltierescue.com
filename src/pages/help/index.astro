---
import 'src/styles/global.css';

import Layout from '@layouts/Layout.astro';

const articles = [
  {
    title: 'Housetraining Tips',
    href: '/help/articles/housetraining/',
    description: 'Rule out medical causes, prevent accidents, establish a routine, and reward successful outdoor trips.',
  },
  {
    title: 'Bringing Your New Sheltie Home',
    href: '/help/articles/bringing-your-sheltie-home/',
    description: 'Prepare essential supplies, make safe introductions, and help your new family member adjust at their own pace.',
  },
  {
    title: 'Communicating with Your Sheltie',
    href: '/help/articles/communicating/',
    description: 'Recognize canine body language and understand signs of fear, anxiety, comfort, and play.',
  },
  {
    title: 'My Sheltie Barks',
    href: '/help/articles/barking/',
    description: 'Understand why Shelties bark and use practical management and training techniques to reduce it.',
  },
  {
    title: 'Grooming Your Pet Sheltie',
    href: '/help/articles/grooming/',
    description: 'Learn about coat care, brushing, bathing, nail trimming, and making grooming a positive experience.',
  },
  {
    title: 'Fostering a Sheltie',
    href: '/help/articles/fostering/',
    description: 'Understand the foster-home role and how to prepare a rescued Sheltie for a successful adoption.',
  },
];
---

<Layout
  title="Help"
  description="Expert help and advice for your sheltie."
>
  <div class="row">
    <div class="large-12 medium-12 small-12 columns">
      <main id="main-content" class="main-content">
        <h1 class="headline first">Expert Help and Advice</h1>
        <p>Phyllis Beasley is past co-founder of South Carolina Sheltie Rescue. She is a certified professional dog trainer (CPDT-KA) through the Council for the Certification of Professional Dog Trainers. She is an assistant trainer with Pawsitive Results, LLC, and a volunteer trainer for the Greater Columbia Obedience Club. Phyllis also volunteers her training skills with SC Sheltie Rescue to help foster and adoptive homes, including writing helpful articles addressing many issues that arise with sheltie ownership or fostering. Please check back for more articles to come!</p>

        <section class="mb-5" aria-labelledby="help-articles-heading">
          <h2 id="help-articles-heading" class="headline">Articles</h2>
          <ul class="m-0 grid list-none gap-4 md:grid-cols-2 lg:grid-cols-3">
            {articles.map((article) => (
              <li class="flex">
                <a class="group flex grow flex-col border border-stone-300 bg-stone-100 p-5 text-zinc-800 hover:border-primary-c hover:bg-neutral-200 hover:text-zinc-900 focus:border-primary-c focus:bg-neutral-200 focus:text-zinc-900" href={article.href}>
                  <h3 class="text-xl font-semibold text-primary-c group-hover:text-primary-c-darker group-focus:text-primary-c-darker">{article.title}</h3>
                  <p class="mb-0 grow">{article.description}</p>
                  <span class="mt-auto pt-3 font-semibold text-primary-c group-hover:text-primary-c-darker group-focus:text-primary-c-darker">Read Article</span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <h2 class="headline">Community Support</h2>
        <p>
          South Carolina Sheltie Rescue is grateful for community relationships that support rescue work, foster families, and dogs in transition.
          <a href="https://oneluckypup.com/about/">One Lucky Pup</a> is a Charlotte-area pet care provider offering structured dog daycare, overnight boarding, grooming, and training, and we appreciate their support for local rescue efforts.
        </p>
      </main>
    </div>
  </div>
</Layout>
