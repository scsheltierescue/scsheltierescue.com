---
import 'src/styles/global.css';

interface BreadcrumbItem {
  text: string;
  href?: string;
}
interface Props {
  crumbs: BreadcrumbItem[];
}

const { crumbs } = Astro.props;
---

<nav class="breadcrumbs border border-solid border-zinc-300 rounded overflow-hidden py-2.5 px-3.5 bg-zinc-100" aria-label="Breadcrumb">
  <ol class="flex list-none m-0">
    {
      crumbs.map((crumb) => {
        if (crumb.href) {
          return (
            <li class="text-primary-c before:text-neutral-400 text-[11px] leading-none uppercase m-0">
              <a class="hover:underline focus:underline" href={crumb.href}>{crumb.text}</a>
            </li>
          );
        } else {
          return (
            <li class="current text-zinc-800 before:text-neutral-400 text-[11px] leading-none uppercase m-0 cursor-default" aria-current="page">{crumb.text}</li>
          );
        }
      })
    }
  </ol>
</nav>

<style>
  li:first-child:before {
    content: " ";
    margin: 0;
  }

  li:before {
    content: "/";
    margin: 0 .75rem;
  }
</style>
